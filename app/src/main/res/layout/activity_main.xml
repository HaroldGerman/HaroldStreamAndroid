<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/backgroundColor">

    <!-- Contenido Principal de la Aplicación -->
    <LinearLayout
        android:id="@+id/layout_app_main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_above="@+id/layout_mini_player"
        android:paddingBottom="4dp">

        <!-- Cabecera Principal Premium (Buscar música) -->
        <LinearLayout
            android:id="@+id/layout_main_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="18dp"
            android:paddingTop="28dp"
            android:paddingBottom="10dp"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Buscar música"
                    android:textColor="?attr/textMainColor"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Encuentra tus canciones favoritas"
                    android:textColor="?attr/textSecColor"
                    android:textSize="13sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_theme_toggle"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_pill_inactive"
                android:src="@drawable/ic_theme_dark"
                app:tint="@color/violet_primary"
                android:contentDescription="Cambiar tema" />

            <ImageButton
                android:id="@+id/btn_header_config"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_pill_inactive"
                android:src="@drawable/ic_music_note"
                app:tint="@color/violet_primary"
                android:contentDescription="Configuración" />
        </LinearLayout>

        <!-- Buscador superior -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:id="@+id/layout_buscador"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Campo de búsqueda en tarjeta redondeada -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    app:cardCornerRadius="24dp"
                    app:cardBackgroundColor="?attr/cardColor"
                    app:cardElevation="3dp"
                    app:cardMaxElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="12dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_search"
                            app:tint="?attr/textSecColor"
                            android:contentDescription="Lupa" />

                        <EditText
                            android:id="@+id/et_busqueda"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:hint="Buscar canción o artista..."
                            android:textColorHint="?attr/textSecColor"
                            android:textColor="?attr/textMainColor"
                            android:textSize="14sp"
                            android:paddingHorizontal="10dp"
                            android:background="@null"
                            android:inputType="text"
                            android:maxLines="1"
                            android:imeOptions="actionSearch" />

                        <ImageButton
                            android:id="@+id/btn_clear_search"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="?android:attr/selectableItemBackgroundBorderless"
                            android:src="@android:drawable/ic_menu_close_clear_cancel"
                            app:tint="?attr/textSecColor"
                            android:contentDescription="Limpiar"
                            android:visibility="gone" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Botón Buscar Violeta -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_buscar"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="10dp"
                    android:text="Buscar"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:paddingHorizontal="22dp"
                    android:background="@drawable/bg_pill_active" />
            </LinearLayout>

            <!-- Tarjeta de Sugerencias Flotante (Anclada debajo del buscador) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cv_sugerencias_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/layout_buscador"
                android:layout_marginTop="4dp"
                android:visibility="gone"
                app:cardBackgroundColor="?attr/cardColor"
                app:cardCornerRadius="16dp"
                app:cardElevation="8dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_sugerencias"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:paddingVertical="4dp"/>

            </androidx.cardview.widget.CardView>

        </RelativeLayout>

        <!-- Barra de Pestañas / Pills (Todos | Favoritas | Offline | Álbumes) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="12dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_tab_nube"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:text="Todos"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:paddingHorizontal="18dp"
                    android:background="@drawable/bg_pill_active" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_tab_favoritas"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginHorizontal="3dp"
                    android:text="Favoritas"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="?attr/textSecColor"
                    android:paddingHorizontal="18dp"
                    android:background="@drawable/bg_pill_inactive" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_tab_descargadas"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginHorizontal="3dp"
                    android:text="Offline"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="?attr/textSecColor"
                    android:paddingHorizontal="18dp"
                    android:background="@drawable/bg_pill_inactive" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_tab_albumes"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="3dp"
                    android:text="Álbumes"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="?attr/textSecColor"
                    android:paddingHorizontal="18dp"
                    android:background="@drawable/bg_pill_inactive" />

            </LinearLayout>
        </HorizontalScrollView>

        <!-- Banner de Estado Modo Offline -->
        <TextView
            android:id="@+id/tv_offline_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎧 MODO OFFLINE ACTIVO"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingVertical="6dp"
            android:background="#EF4444"
            android:layout_marginBottom="8dp"
            android:visibility="gone" />

        <!-- Título de Sección y Contador -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="18dp"
            android:paddingVertical="4dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_seccion_titulo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Resultados encontrados"
                android:textColor="?attr/textMainColor"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_resultados_counter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 canciones"
                android:textColor="@color/violet_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="16dp"
            android:visibility="gone" />

        <!-- RecyclerView de lista de canciones -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_resultados"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingHorizontal="12dp"
            android:paddingTop="4dp"
            android:clipToPadding="false" />

    </LinearLayout>

    <!-- Incluir Dashboard de Inicio -->
    <include
        layout="@layout/layout_inicio_dashboard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/layout_mini_player" />

    <!-- Mini-Reproductor Flotante en la Parte Inferior (Posicionado arriba de la barra inferior) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/layout_mini_player"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_above="@+id/layout_bottom_nav"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="10dp"
        app:cardCornerRadius="20dp"
        app:cardBackgroundColor="?attr/cardColor"
        app:cardElevation="8dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:gravity="center_vertical">

            <!-- Portada de mini reproductor -->
            <androidx.cardview.widget.CardView
                android:layout_width="44dp"
                android:layout_height="44dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                android:backgroundTint="?attr/backgroundColor">

                <ImageView
                    android:id="@+id/iv_mini_thumb"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="Mini Portada" />
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_mini_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Título de Canción"
                    android:textColor="?attr/textMainColor"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tv_mini_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Artista"
                    android:textColor="?attr/textSecColor"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_mini_play_pause"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_media_play"
                app:tint="?attr/textMainColor"
                android:contentDescription="Play/Pausa" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Barra de Navegación Inferior Fija -->
    <LinearLayout
        android:id="@+id/layout_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:background="?attr/cardColor"
        android:elevation="12dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:id="@+id/nav_inicio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/iv_nav_inicio"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_home"
                app:tint="?attr/textSecColor"/>
            <TextView
                android:id="@+id/tv_nav_inicio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Inicio"
                android:textSize="11sp"
                android:textColor="?attr/textSecColor"
                android:layout_marginTop="3dp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_buscar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/iv_nav_buscar"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_search"
                app:tint="@color/violet_primary"/>
            <TextView
                android:id="@+id/tv_nav_buscar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Buscar"
                android:textSize="11sp"
                android:textColor="@color/violet_primary"
                android:layout_marginTop="3dp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_favoritas"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/iv_nav_favoritas"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_heart_outline"
                app:tint="?attr/textSecColor"/>
            <TextView
                android:id="@+id/tv_nav_favoritas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Favoritas"
                android:textSize="11sp"
                android:textColor="?attr/textSecColor"
                android:layout_marginTop="3dp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_descargas"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/iv_nav_descargas"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_download"
                app:tint="?attr/textSecColor"/>
            <TextView
                android:id="@+id/tv_nav_descargas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Descargas"
                android:textSize="11sp"
                android:textColor="?attr/textSecColor"
                android:layout_marginTop="3dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- CAPA DE AUTENTICACIÓN Y REGISTRO (OVERLAY BLOQUEADO) -->
    <LinearLayout
        android:id="@+id/layout_auth_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:background="?attr/backgroundColor"
        android:clickable="true"
        android:focusable="true"
        android:elevation="20dp"
        android:visibility="gone">

        <!-- VISTA 1: FORMULARIO DE REGISTRO Y SOLICITUD DE PIN -->
        <LinearLayout
            android:id="@+id/layout_registro_form"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/bg_card_glowing"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔐 Registro de Usuario"
                android:textColor="@color/violet_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ingresa tu nombre y celular para recibir tu código PIN de verificación."
                android:textColor="?attr/textSecColor"
                android:textSize="13sp"
                android:gravity="center"
                android:layout_marginBottom="20dp" />

            <EditText
                android:id="@+id/et_reg_nombre"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="👤 Nombre y Apellido"
                android:textColorHint="?attr/textSecColor"
                android:textColor="?attr/textMainColor"
                android:textSize="14sp"
                android:paddingHorizontal="16dp"
                android:background="@drawable/bg_edittext"
                android:inputType="textPersonName"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/et_reg_telefono"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="📱 Número de Celular"
                android:textColorHint="?attr/textSecColor"
                android:textColor="?attr/textMainColor"
                android:textSize="14sp"
                android:paddingHorizontal="16dp"
                android:background="@drawable/bg_edittext"
                android:inputType="phone"
                android:layout_marginBottom="20dp" />

            <android.widget.Button
                android:id="@+id/btn_reg_enviar"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="SOLICITAR CÓDIGO PIN"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_pill_active" />

        </LinearLayout>

        <!-- VISTA 2: FORMULARIO DE INGRESO DE CÓDIGO PIN DE 4 DÍGITOS -->
        <LinearLayout
            android:id="@+id/layout_codigo_form"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/bg_card_glowing"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔑 Código de Verificación"
                android:textColor="@color/violet_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tv_codigo_instruccion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ingresa el código PIN de 4 dígitos enviado a tu dispositivo:"
                android:textColor="?attr/textSecColor"
                android:textSize="13sp"
                android:gravity="center"
                android:layout_marginBottom="20dp" />

            <EditText
                android:id="@+id/et_reg_pin"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="🔑 PIN de 4 dígitos"
                android:textColorHint="?attr/textSecColor"
                android:textColor="?attr/textMainColor"
                android:textSize="22sp"
                android:textStyle="bold"
                android:gravity="center"
                android:maxLength="4"
                android:paddingHorizontal="16dp"
                android:background="@drawable/bg_edittext"
                android:inputType="number"
                android:layout_marginBottom="20dp" />

            <android.widget.Button
                android:id="@+id/btn_verificar_pin"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="VERIFICAR CÓDIGO PIN"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_pill_active" />

        </LinearLayout>

        <!-- VISTA 3: PANTALLA DE PENDIENTE DE APROBACIÓN POR ADMIN -->
        <LinearLayout
            android:id="@+id/layout_pendiente_form"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/bg_card_glowing"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏳ Esperando Aprobación"
                android:textColor="#F59E0B"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tv_pendiente_mensaje"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¡Código PIN verificado con éxito! Tu dispositivo ya aparece en el Panel Administrador. Espera a que Harold lo apruebe."
                android:textColor="?attr/textSecColor"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_marginBottom="24dp" />

            <android.widget.Button
                android:id="@+id/btn_verificar_estado"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="🔄 VERIFICAR APROBACIÓN"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_pill_active" />

        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
