<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/cardColor"
    android:padding="20dp">

    <View
        android:layout_width="60dp"
        android:layout_height="5dp"
        android:layout_gravity="center_horizontal"
        android:background="?attr/borderColor"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tv_lyrics_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎤 Letra de la canción"
            android:textColor="?attr/textMainColor"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center_horizontal"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/pb_lyrics_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginVertical="32dp"
        android:indeterminateTint="@color/violet_primary" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/sv_lyrics_scroll"
        android:layout_width="match_parent"
        android:layout_height="380dp"
        android:padding="12dp"
        android:background="?attr/backgroundColor"
        android:scrollbars="vertical">

        <LinearLayout
            android:id="@+id/container_lyrics_lines"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/tv_lyrics_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Buscando letra..."
                android:textColor="?attr/textMainColor"
                android:textSize="15sp"
                android:lineSpacingExtra="6dp"
                android:gravity="center_horizontal" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
